# ============================================================================
#  项目004 — WordPress 完整站点（PHP + MySQL）忽略规则
#
#  public/ 是 WordPress 站点根（含 wp-admin/wp-includes 与主题、插件）。
#  核心代码可按需入库，但【运行时产物】必须排除：用户上传、缓存、数据库导出、
#  站点备份与真实凭据。这些既臃肿又含隐私，且随运行不断变化。
# ============================================================================

# ===== 依赖 =====
node_modules/
**/node_modules/

# ⚠️ 不要写裸 vendor/ ：WordPress 核心的 public/wp-includes/js/dist/vendor/
# 存放 react / lodash / moment / wp-polyfill 等【站点运行必需】的前端库，
# 裸规则会把这 30 个文件一并排除，导致站点白屏。这里改为根级锚定，
# 只排除 Composer 依赖，并显式反向保留 WP 核心 vendor 目录。
/vendor/
public/wp-content/plugins/*/vendor/
public/wp-content/themes/*/vendor/
!public/wp-includes/js/dist/vendor/
!public/wp-includes/js/dist/vendor/**

# ===== 环境与数据库凭据（绝不入库）=====
.env
.env.local
.env.*.local
**/.env
!**/.env.example
backups/
_dist/

# ===== WordPress 运行时产物（隐私 + 易变，排除）=====
public/wp-content/uploads/
public/wp-content/cache/
public/wp-content/upgrade/
public/wp-content/backup*/
public/wp-content/plugins/*/cache/
public/wp-content/wflogs/
public/wp-content/debug.log

# ===== 数据库导出与备份（可能含用户数据/口令散列）=====
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.db-journal
*.bak
*.tar
*.tar.gz
*.tgz
*.zip

# ===== PHP 运行时与日志 =====
*.log
router.log
error_log
debug.log

# ===== 系统与编辑器临时文件 =====
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
