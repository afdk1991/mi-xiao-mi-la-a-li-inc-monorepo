# =============================================================================
# 项目004 · MySQL 8 配置
#
# 关键点：
#   skip-name-resolve —— 容器网络下必须开启。否则 MySQL 会对每个客户端 IP
#   做反向 DNS 解析，在 Docker/WSL 网络中经常超时，表现为连接时好时坏、
#   "Error while reading greeting packet"、errno 2002 等间歇性故障。
# =============================================================================

[mysqld]
# 字符集：WordPress 推荐 utf8mb4
character-set-server          = utf8mb4
collation-server              = utf8mb4_unicode_520_ci

# 关闭反向 DNS 解析（容器环境必备）
skip-name-resolve

# 连接
max_connections               = 200
max_connect_errors            = 1000
wait_timeout                  = 28800
interactive_timeout           = 28800

# InnoDB 基线
default-storage-engine        = InnoDB
innodb_buffer_pool_size       = 256M
innodb_log_file_size          = 128M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method           = O_DIRECT

# SQL 模式：WordPress 对 ONLY_FULL_GROUP_BY 等严格模式兼容良好，保持默认即可
sql_mode                      = ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# 慢查询（排障时开启）
slow_query_log                = 0
long_query_time               = 2

# 允许的最大数据包，避免大文章/大 meta 写入失败
max_allowed_packet            = 64M

# 时区
default-time-zone             = +08:00

[client]
default-character-set         = utf8mb4

[mysql]
default-character-set         = utf8mb4
