{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@gexm/shared": ["./packages/shared/dist"]
    }
  },
  "exclude": ["node_modules", "**/dist", "**/_archive", "wp-admin", "wp-includes"]
}