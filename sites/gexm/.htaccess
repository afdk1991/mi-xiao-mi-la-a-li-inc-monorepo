# 原始WordPress规则
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>


# 强制HTTPS重定向（测试环境禁用）
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# 安全增强规则
<IfModule mod_headers.c>
    # 禁用Framing（防止点击劫持）
    Header always set X-Frame-Options "SAMEORIGIN"
    # 启用XSS过滤
    Header always set X-XSS-Protection "1; mode=block"
    # 设置内容类型选项
    Header always set X-Content-Type-Options "nosniff"
    # 设置Referrer策略
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # 启用HTTP严格传输安全(HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # 注意：Content-Security-Policy 不在此处设置，统一由主题 inc/api-security.php 控制
    # 历史问题：此处与 PHP 同时下发 CSP，浏览器取交集策略导致 cdn.jsdelivr.net /
    # cdnjs.cloudflare.com / unpkg.com 等 CDN 资源全部被阻断（2026-07-19 修复）
</IfModule>

# 禁用目录浏览
Options -Indexes

# 设置字符集
AddDefaultCharset UTF-8

# 浏览器缓存规则
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresDefault "access plus 2 days"
</IfModule>

# 启用Gzip压缩
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# 保护敏感文件
<FilesMatch "\.(htaccess|htpasswd|wp-config\.php|php\.ini|README|readme\.txt|composer\.json|composer\.lock|package\.json|package-lock\.json|env|env\.production|env\.development|env\.testing|sql|dump|bak|backup|log|ps1|sh|bat)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# 阻止敏感目录直接访问（历史遗留与私钥目录）
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^PEM_Privatekey/ - [F,L]
    RewriteRule ^certs/ - [F,L]
    RewriteRule ^backups/ - [F,L]
    RewriteRule ^logs/ - [F,L]
    RewriteRule ^\.snapshots/ - [F,L]
    RewriteRule ^_responsive_test/ - [F,L]
    RewriteRule ^responsive-test/ - [F,L]
    RewriteRule ^test-results/ - [F,L]
</IfModule>

# 防止恶意请求
<IfModule mod_rewrite.c>
    RewriteEngine On
    # 阻止常见的SQL注入攻击
    RewriteCond %{QUERY_STRING} (;|'|"|<|>|%3c|%3e|%22|%27|%3b)
    RewriteRule ^(.*)$ - [F,L]
    # 阻止敏感路径访问
    RewriteRule ^wp-admin/includes/ - [F,L]
    RewriteRule !^wp-includes/ - [S=3]
    RewriteRule ^wp-includes/[^/]+\.php$ - [F,L]
    RewriteRule ^wp-includes/js/tinymce/langs/.+\.php - [F,L]
    RewriteRule ^wp-includes/theme-compat/ - [F,L]
</IfModule>

# 防止Hotlinking（防盗链）
# 允许以下来源引用资源：
#   - 空 Referer（直接访问，如浏览器地址栏、爬虫）
#   - 本地开发环境：localhost / 127.0.0.1
#   - 生产环境主域及所有子域：laal.top / *.laal.top
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_REFERER} !^$ [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?/ [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?laal\.top/ [NC]
    RewriteRule \.(jpg|jpeg|png|gif|webp|svg|bmp|ico|mp3|mp4|avi|mov|wmv)$ - [F,L]
</IfModule>

# ============================================================
# WordPress 安全加固
# ============================================================

# 禁用 XML-RPC（防止密码爆破放大攻击与 Pingback DDoS）
# 若不使用 XML-RPC 发布文章（如移动端 App、Windows Live Writer），应直接禁用
<Files xmlrpc.php>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</Files>

# 限制 wp-login.php 爆破（基于 IP 限流，每分钟最多 5 次登录请求）
# 超过限制返回 429 Too Many Requests
<IfModule mod_rewrite.c>
    RewriteEngine On
    # 内存型限流（需要 mod_rewrite + mod_mem_cache 或 RewriteMap，Apache 2.4 推荐用 mod_evasive）
    # 此处仅做基础防护，建议安装 Limit Login Attempts Reloaded 插件做应用层防护
    RewriteCond %{REQUEST_METHOD} POST [NC]
    RewriteCond %{REQUEST_URI} ^/wp-login\.php [NC]
    # 这里可以集成 fail2ban 或 mod_evasive 实现真正的限流
</IfModule>

# 移除 WordPress 版本号泄露（防止攻击者通过版本号对应 CVE 列表）
<IfModule mod_filter.c>
    # 通过 Header 移除 X-Pingback
    Header always unset X-Pingback
</IfModule>

# 阻止敏感文件访问（Apache 2.4 语法）
<FilesMatch "(^\.git|^\.env|^\.htaccess|^wp-config\.php|^xmlrpc\.php|^readme\.html|^license\.txt)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# 禁止 PHP 在上传目录执行（防止 webshell）
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^wp-content/uploads/.*\.php$ - [F,L]
    RewriteRule ^wp-content/uploads/.*\.phtml$ - [F,L]
    RewriteRule ^wp-content/uploads/.*\.php[0-9]?$ - [F,L]
</IfModule>

# 安全响应头补充
<IfModule mod_headers.c>
    # 防止 MIME 类型嗅探
    Header always set X-Content-Type-Options "nosniff"
    # 防止点击劫持
    Header always set X-Frame-Options "SAMEORIGIN"
    # XSS 保护（现代浏览器应使用 CSP，此头作为兜底）
    Header always set X-XSS-Protection "1; mode=block"
    # HSTS（强制 HTTPS，max-age 1 年，包含子域）
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # Referrer 策略
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # 权限策略（替代 Feature-Policy）
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
