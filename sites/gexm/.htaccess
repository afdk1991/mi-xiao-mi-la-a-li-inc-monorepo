# 子域名模块页面重定向规则
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# ============================================================
# module 参数白名单校验（防止未授权模块访问）
# 仅允许已注册的子域名模块通过 module 参数路由
# 若 module 参数不在白名单，回退到 WordPress 默认路由
# ============================================================
RewriteCond %{QUERY_STRING} (^|&)module=([^&]+)(&|$)
RewriteCond %2 !^(home|api|www|wp|blog|m|shop|dy|xw|yy|video|user|test|support|store|stats|sp|sj|service|secure|portal|pay|news|mobile|market|mall|login|img|help|gy|fwq|dnpj|dh|dev|data|cloud|center|auth|app|admin)$ [NC]
RewriteRule ^index\.php$ - [F,L]

# 主域名重定向到首页
RewriteCond %{HTTP_HOST} ^laal\.top$ [NC]
RewriteCond %{REQUEST_URI} !^/index\.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.php?module=home&path=$1 [L,QSA]

# API子域名重定向到api模块
RewriteCond %{HTTP_HOST} ^api\.laal\.top$ [NC]
RewriteCond %{REQUEST_URI} !^/index\.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.php?module=api&path=$1 [L,QSA]

