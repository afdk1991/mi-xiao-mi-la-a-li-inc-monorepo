<?xml version="1.0"?>
<ruleset name="GEXM WordPress Coding Standards">
    <description>GEXM 项目 WordPress 编码标准配置 - 生产级质量加固版</description>

    <file>wp-content/plugins/</file>
    <file>wp-content/themes/</file>

    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/.git/*</exclude-pattern>
    <exclude-pattern>*/wp-admin/*</exclude-pattern>
    <exclude-pattern>*/wp-includes/*</exclude-pattern>
    <exclude-pattern>*/uploads/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>

    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
        <exclude name="WordPress.WP.I18n"/>
    </rule>

    <rule ref="WordPress.Core">
        <exclude name="WordPress.Core.YodaConditions"/>
    </rule>

    <rule ref="WordPress.PHP">
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions"/>
    </rule>

    <rule ref="WordPress.DB.RestrictedFunctions">
        <exclude-pattern>*/wp-includes/*</exclude-pattern>
        <exclude-pattern>*/wp-admin/*</exclude-pattern>
    </rule>

    <rule ref="WordPress.Security">
        <severity>5</severity>
    </rule>

    <rule ref="WordPress.Security.EscapeOutput">
        <severity>5</severity>
    </rule>

    <rule ref="WordPress.Security.NonceVerification">
        <severity>5</severity>
    </rule>

    <rule ref="WordPress.Security.PluginMenuSlug">
        <severity>5</severity>
    </rule>

    <rule ref="WordPress.Security.SafeRedirect">
        <severity>5</severity>
    </rule>

    <rule ref="WordPress.DB.PreparedSQL">
        <severity>5</severity>
    </rule>

    <rule ref="WordPress.DB.PreparedSQLPlaceholders">
        <severity>5</severity>
    </rule>

    <rule ref="WordPress.WP.GlobalVariablesOverride">
        <severity>5</severity>
    </rule>

    <rule ref="Generic.PHP.Syntax">
        <severity>5</severity>
    </rule>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="180"/>
        </properties>
    </rule>

    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <properties>
            <property name="indent" value="4"/>
            <property name="tabIndent" value="false"/>
        </properties>
    </rule>

    <rule ref="Squiz.PHP.CommentedOutCode">
        <severity>0</severity>
    </rule>

    <rule ref="PSR12">
        <exclude name="PSR12.Files.FileHeader"/>
        <exclude name="PSR12.Classes.ClassInstantiation"/>
    </rule>

    <config name="minimum_supported_wp_version" value="6.0"/>
    <config name="testVersion" value="7.4-"/>

    <arg value="s"/>
    <arg value="p"/>
    <arg name="colors"/>
    <arg name="parallel" value="10"/>
</ruleset>
