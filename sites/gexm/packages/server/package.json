{
  "name": "@gexm/server",
  "version": "1.0.0",
  "description": "Gexm 全平台后端服务",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "start:prod": "cross-env NODE_ENV=production node dist/server.js",
    "build": "tsc",
    "build:dev": "tsc --sourceMap --watch",
    "lint": "npx eslint . --ext .ts,.js --config ../../eslint.config.js",
    "lint:fix": "npx eslint . --ext .ts,.js --fix",
    "lint:security": "npx eslint . --ext .ts,.js --rule 'security/*:error'",
    "typecheck": "tsc --noEmit",
    "test": "npx jest",
    "test:watch": "npx jest --watch",
    "test:postgres": "cross-env DB_TYPE=postgres DB_HOST=localhost DB_PORT=5433 DB_NAME=gexm_test DB_USER=gexm_test DB_PASSWORD=gexm_test_password npx jest",
    "migrate": "tsx src/commands/migrate.ts",
    "migrate:run": "tsx src/commands/migrate.ts run",
    "migrate:verify": "tsx src/commands/migrate.ts verify",
    "test:postgres:setup": "powershell -ExecutionPolicy Bypass -File scripts/docker-pg-start.ps1",
    "test:postgres:teardown": "powershell -ExecutionPolicy Bypass -File scripts/docker-pg-stop.ps1"
  },
  "dependencies": {
    "@gexm/shared": "file:../shared",
    "@langchain/core": "^0.3.80",
    "@langchain/mcp-adapters": "^0.6.0",
    "@langchain/openai": "^0.6.17",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.3.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "deasync": "^0.1.31",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.37",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.22.0",
    "redis": "^4.7.1",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.12.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss": "^1.0.15",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/kafkajs": "^1.8.2",
    "@types/node": "^26.0.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^9.39.4",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unicorn": "^59.0.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2"
  }
}
