PORT=3000
NODE_ENV=development

# ==================== 安全密钥配置 ====================
# 开发环境可不设置（自动生成临时密钥），生产环境必须全部设置强随机密钥
# 生成命令：
#   Hex格式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 密钥强度要求：长度 >= 32、包含大小写字母/数字/特殊字符（或 64 位 Hex 格式）
JWT_SECRET=
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=gexm
JWT_AUDIENCE=gexm-client
CSRF_SECRET=
PII_ENCRYPTION_KEY=
PAYMENT_SECRET=

# Database
DATABASE_PATH=./data/gexm.db

# OAuth - WeChat Open Platform (Web Login)
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_OPEN_REDIRECT_URI=http://localhost:3000/api/oauth/wechat/callback

# OAuth - WeChat Official Account
WECHAT_OA_APP_ID=
WECHAT_OA_APP_SECRET=
WECHAT_OA_REDIRECT_URI=http://localhost:3000/api/oauth/wechat/official-account/callback

# OAuth - WeChat Mini Program
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=

# OAuth - QQ
QQ_APP_ID=
QQ_APP_SECRET=
QQ_REDIRECT_URI=http://localhost:3000/api/oauth/qq/callback

# OAuth - Weibo
WEIBO_APP_ID=
WEIBO_APP_SECRET=
WEIBO_REDIRECT_URI=http://localhost:3000/api/oauth/weibo/callback

# OAuth - Alipay
ALIPAY_APP_ID=
ALIPAY_APP_SECRET=
ALIPAY_REDIRECT_URI=http://localhost:3000/api/oauth/alipay/callback
ALIPAY_PRIVATE_KEY=

# OAuth - Google
GOOGLE_APP_ID=
GOOGLE_APP_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# OAuth - Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/oauth/facebook/callback

# OAuth - Twitter
TWITTER_APP_ID=
TWITTER_APP_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/api/oauth/twitter/callback

# Admin Default Password
ADMIN_DEFAULT_PASSWORD=admin123456

# Redis (optional - for production)
REDIS_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Upload
UPLOAD_PATH=./uploads
UPLOAD_MAX_SIZE=10485760