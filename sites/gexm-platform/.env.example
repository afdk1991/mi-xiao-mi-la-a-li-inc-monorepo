# =====================================================================
# Gexm 项目环境变量配置模板
# =====================================================================
# 使用方法：
#   1. 复制此文件为 .env 并修改对应值
#   2. 命令：cp .env.example .env (Linux/macOS) 或 copy .env.example .env (Windows)
#   3. 根据实际部署场景修改配置
#
# 安全注意事项：
#   - .env 文件已被 .gitignore 忽略，不会提交到 Git 仓库
#   - 生产环境所有密钥必须使用强随机字符串（至少 32 字符）
#   - 不要在任何代码仓库、文档或聊天中泄露真实密钥
#   - 不同环境（开发/测试/生产）必须使用不同的密钥
#   - 定期轮换密钥（建议每 90 天）
#
# 密钥生成命令：
#   Hex 格式:    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Base64 格式: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# =====================================================================

# ---------------------------------------------------------------------
# 运行环境配置
# ---------------------------------------------------------------------
# 运行环境：development | staging | production | test
NODE_ENV=development

# ---------------------------------------------------------------------
# WordPress 数据库配置（使用 WordPress 功能时必填）
# ---------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=laal_top
MYSQL_USER=laal_top
MYSQL_PASSWORD=your_password_here

# ---------------------------------------------------------------------
# WordPress 配置
# ---------------------------------------------------------------------
# WordPress 调试模式（开发环境建议开启，生产环境必须关闭）
WORDPRESS_DEBUG=true
# 环境标识（development / production）
WP_ENV=development
# WordPress 对外访问端口（避免与 Node.js app 服务的 80 端口冲突）
WP_PORT=8081

# ---------------------------------------------------------------------
# Node.js 服务端口配置
# ---------------------------------------------------------------------
# 后端 API 服务端口
SERVER_PORT=3000
# H5/Web 前端服务端口
APP_PORT=80
# PC 管理后台服务端口
PC_PORT=8080

# ---------------------------------------------------------------------
# 数据库配置（Node.js 后端）
# ---------------------------------------------------------------------
# 数据库类型：sqlite | postgres
DB_TYPE=sqlite
# SQLite 数据库路径（DB_TYPE=sqlite 时生效）
DB_PATH=./data/gexm.db
# PostgreSQL 连接配置（DB_TYPE=postgres 时生效）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gexm
POSTGRES_USER=gexm
POSTGRES_PASSWORD=your_postgres_password_here
# PostgreSQL 连接字符串（可选，配置后会覆盖单独配置）
# 格式：postgres://user:pass@host:port/database
POSTGRES_URL=

# ---------------------------------------------------------------------
# Redis 缓存配置
# ---------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
# Redis URL（可选，格式：redis://:password@host:port/db）
REDIS_URL=

# ---------------------------------------------------------------------
# JWT 安全配置（生产环境必填）
# ---------------------------------------------------------------------
# [生产必填] JWT Access Token 签名密钥（>= 32 位）
JWT_SECRET=
# JWT Access Token 过期时间：2h / 1d / 30m
JWT_EXPIRES_IN=2h
# [生产必填] JWT Refresh Token 签名密钥（>= 32 位，与 JWT_SECRET 不同）
JWT_REFRESH_SECRET=
# JWT Refresh Token 过期时间：7d / 14d
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------
# 其他安全配置
# ---------------------------------------------------------------------
# [生产必填] CSRF 防护密钥
CSRF_SECRET=
# [生产必填] PII 数据加密密钥（AES-256，用于敏感数据加密）
PII_ENCRYPTION_KEY=
# [生产必填] 支付签名密钥
PAYMENT_SECRET=
# 超级管理员初始密码（首次启动使用，需 >= 12 位含大小写/数字/特殊字符）
ADMIN_DEFAULT_PASSWORD=

# ---------------------------------------------------------------------
# CORS 配置
# ---------------------------------------------------------------------
# 允许的跨域源，逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# 是否强制 HTTPS（生产环境推荐开启）
FORCE_HTTPS=false

# ---------------------------------------------------------------------
# 日志配置
# ---------------------------------------------------------------------
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
# 是否在日志中脱敏敏感数据（生产环境强制开启）
LOG_MASK_SENSITIVE_DATA=true
