# Dependencies
node_modules/
.pnpm-store/
package-lock.json
# 例外：需要在 CI 中做可复现构建并部署的应用，其锁文件必须入库（否则 npm ci 装到旧版本）
!apps/delivery-router/package-lock.json

# Build output
dist/
build/
.output/
.out/
release/
*.tsbuildinfo

# Caches
.cache/
__pycache__/
.venv/
.wrangler/
# 任意层级的 EdgeOne 部署产物（CLI 会把站点副本塞进来）
# 注意：gitignore 不支持行尾内联注释，`pattern # 注释` 会让整条规则失效
**/.edgeone/*
# 例外：项目绑定文件必须入库，防 CLI 另建项目
!**/.edgeone/project.json
.workbuddy/tmp/

# 本地扫描产物：含命中行的上下文片段，绝不能入库
# （教训：扫描报告本身也是文件，一旦提交就等于把密钥复制了一份进仓库）
.wb_scan.*
*.scan.json

# Secrets / env
# 说明：gitignore 只对「未跟踪」文件生效。若某个 .env 已被 git 跟踪（本仓库曾发生），
# 规则不会自动生效，必须显式执行 `git rm --cached <file>` 摘除索引（工作区文件保留）。
# 已跟踪文件被摘除后，模板（.env*.example）仍需入库，故下方加例外。
.env
.env.*
!.env.example
!.env.*.example
!.env*.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.idea/
.vscode/
.trae/
.DS_Store
Thumbs.db

# Misc generated
*.exe~
*.bak
.gopath/

# Local backups / git bundles (not source, huge)
_backups/
*.bundle

# Electron / desktop build outputs (regenerable, huge — must not be in git)
**/win-unpacked/
**/electron-output/
**/build-output/
**/dist-win*/
**/dist-electron/

# Vendored WordPress download archive (re-download, not source)
sites/ardot-audit/_dist/
_deploy/
.workbuddy/
*.genie
sites/ai-server-resources/archive/verify-*.png

# Stale build artifacts & tracked-but-sensitive files (must never be public)
# 带日期的构建残留（如 daijia-dist_old_20261002_141312）曾被强制入库，含硬编码 Key，必须排除
**/*-dist_old*/
**/daijia-dist_old*/
**/_smoke*.log
**/fetched/

# 构建产物：编译可再生成，且易把前端环境变量（VITE_*/REACT_APP_*）内联进去，一律不入库。
# 说明：以下目录已有文件被跟踪，需用 git rm --cached 摘除（gitignore 对已跟踪文件无效）。
#
# ⚠️ 刻意不用 `**/dist/` 通配：WordPress 核心自带 `wp-includes/js/dist` 与
#    `wp-includes/css/dist` 官方目录（sites/ardot-audit/public 下共 354 个文件），
#    通配会把它们一起排除掉而破坏站点。此处按实际构建产物路径精确列出。
apps/mixmlaal-fullstack/mixmlaal-dist/
apps/mixmlaal-fullstack/mixmlaal-apps/*/dist/
apps/mixmlaal-fullstack/mixmlaal-deploy-script/
apps/manju/dist/
**/dist-assets/
**/*-dist-assets/
**/deploy-script-assets/
**/daijia-dist/

# Email-aggregator 本地密钥库（已用 REK 加密落盘，但绝不入库；含同目录机器密钥 <file>.mkey）
**/kms-keyring*.json
**/kms-keyring*.json.mkey
