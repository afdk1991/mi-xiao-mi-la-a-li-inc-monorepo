# Dependencies
node_modules/
.pnpm-store/
package-lock.json
# 例外：需要在 CI 中做可复现构建并部署的应用，其锁文件必须入库（否则 npm ci 装到旧版本）
!apps/delivery-router/package-lock.json

# Build output
dist/
build/
.output/
.out/
release/
*.tsbuildinfo

# Caches
.cache/
__pycache__/
.venv/
.wrangler/
# 任意层级的 EdgeOne 部署产物（CLI 会把站点副本塞进来）
# 注意：gitignore 不支持行尾内联注释，`pattern # 注释` 会让整条规则失效
**/.edgeone/*
# 例外：项目绑定文件必须入库，防 CLI 另建项目
!**/.edgeone/project.json
.workbuddy/tmp/

# Secrets / env
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.idea/
.vscode/
.trae/
.DS_Store
Thumbs.db

# Misc generated
*.exe~
*.bak
.gopath/

# Local backups / git bundles (not source, huge)
_backups/
*.bundle

# Electron / desktop build outputs (regenerable, huge — must not be in git)
**/win-unpacked/
**/electron-output/
**/build-output/
**/dist-win*/
**/dist-electron/

# Vendored WordPress download archive (re-download, not source)
sites/ardot-audit/_dist/
_deploy/
.workbuddy/
*.genie
sites/ai-server-resources/archive/verify-*.png

# Stale build artifacts & tracked-but-sensitive files (must never be public)
# 带日期的构建残留（如 daijia-dist_old_20261002_141312）曾被强制入库，含硬编码 Key，必须排除
**/*-dist_old*/
**/daijia-dist_old*/
**/_smoke*.log
**/fetched/

# Email-aggregator 本地密钥库（已用 REK 加密落盘，但绝不入库；含同目录机器密钥 <file>.mkey）
**/kms-keyring*.json
**/kms-keyring*.json.mkey
