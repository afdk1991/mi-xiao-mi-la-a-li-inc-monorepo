# Dependencies
node_modules/
.pnpm-store/
package-lock.json

# Build output
dist/
build/
.output/
.out/
release/
*.tsbuildinfo

# Caches
.cache/
__pycache__/
.venv/
.wrangler/
**/.edgeone/*                    # 任意层级的 EdgeOne 部署产物（CLI 会把站点副本塞进来）
!**/.edgeone/project.json        # 例外：项目绑定文件必须入库，防 CLI 另建项目
.workbuddy/tmp/

# Secrets / env
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.idea/
.vscode/
.trae/
.DS_Store
Thumbs.db

# Misc generated
*.exe~
*.bak
.gopath/

# Local backups / git bundles (not source, huge)
_backups/
*.bundle

# Electron / desktop build outputs (regenerable, huge — must not be in git)
**/win-unpacked/
**/electron-output/
**/build-output/
**/dist-win*/
**/dist-electron/

# Vendored WordPress download archive (re-download, not source)
sites/ardot-audit/_dist/
_deploy/
.workbuddy/
*.genie
sites/ai-server-resources/archive/verify-*.png
